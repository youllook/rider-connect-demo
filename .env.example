# =============================================================================
# RIDER Local Detector — 設定檔範本
# =============================================================================
# 使用方式:
#   1. 把這個檔案複製一份、改名為  .env  (去掉 .example)
#   2. 依下方說明填入你的值(等號右邊)
#   3. 把 .env 放在 rider-detector.exe「同一個資料夾」
#   4. 雙擊 exe 啟動
#
# 規則:
#   - 一行一個設定,格式  KEY=VALUE
#   - # 開頭的行是註解,程式會略過
#   - 沒填(或整行刪掉)的項目,會自動用「預設值」,行為跟以前一樣
#   - 改完設定要重開 exe 才生效
# =============================================================================


# ---- 網頁儀表板 -------------------------------------------------------------

# 儀表板網址的主機位址。預設只給本機看;要讓「同網段其他電腦」也能連,改成 0.0.0.0
RIDER_HOST=127.0.0.1

# 儀表板的連接埠(網址後面的數字)。預設 8000 → http://127.0.0.1:8000
# 若 8000 被別的程式占用,改成 8080、9000 之類
RIDER_PORT=8000

# 啟動時要不要自動打開瀏覽器。true=自動開;false=自己手動開網址
RIDER_OPEN_BROWSER=true


# ---- RIDER 裝置(USB / 藍牙)------------------------------------------------

# RIDER 的藍牙位址。每一台 RIDER 不一樣!請填你自己那台的位址。
# (先用儀表板掃描功能或裝置資訊查到位址,再填這裡;弱訊號時填位址最穩)
RIDER_BLE_ADDR=E8:DF:6A:3F:D3:6D

# RIDER 的 USB 識別碼(VID / PID)。一般「不用改」;
# 只有換不同型號 RIDER、USB 燈號一直偵測不到時才需要調整。
RIDER_VID=0x303A
RIDER_PID=0x1001

# USB 序列傳輸速率。一般不用改。
RIDER_BAUDRATE=115200


# ---- Webhook 轉拋(把收到的無人機 RID 自動 POST 給你的後端)-----------------

# 總開關。true=啟用轉拋;false=完全不轉拋(只在儀表板顯示)
RIDER_WEBHOOK_ENABLED=false

# 要轉拋到的端點網址。可以填「多個」,用「逗號」隔開。
# 收到每一筆無人機 RID,都會分別 POST(JSON)到下列每一個網址。
# 範例(兩個端點):
#   RIDER_WEBHOOK_URLS=https://hq.example.com/rid-ingest,http://192.168.0.50:5000/hook
RIDER_WEBHOOK_URLS=

# 每次 POST 的逾時秒數(端點沒回應多久算失敗)。預設 5 秒。
RIDER_WEBHOOK_TIMEOUT=5

# POST 失敗時的重試次數。預設 2(第一次失敗後再試 2 次,共 3 次)。
RIDER_WEBHOOK_RETRIES=2

# 只轉拋「真無人機的 RID」,跳過 RIDER 接收器自身的遙測。
# true=只轉無人機 RID(建議);false=連 RIDER 自身遙測也一起轉
RIDER_WEBHOOK_RID_ONLY=true

# Webhook 送出紀錄要寫到哪個資料夾(每次送出成功/失敗都會記,方便事後查)。
RIDER_WEBHOOK_LOG_DIR=webhook_logs


# ---- 原始資料紀錄(raw log)-------------------------------------------------

# 要不要把 RIDER 送來的原始位元組存檔(萬一解析失敗也留得住原料)。
# true/1=存(預設);0/false=不存,只看畫面
RIDER_RAWLOG=1

# 原始資料存檔的資料夾。預設 raw_logs
RIDER_RAWLOG_DIR=raw_logs
